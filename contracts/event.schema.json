{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.atlas-si.com/contracts/v1/event.schema.json",
  "title": "Atlas TelemetryEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "runId", "agentSlug", "type", "timestamp", "data"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "runId": {"type": "string", "format": "uuid"},
    "agentSlug": {"type": "string", "minLength": 1},
    "type": {"enum": ["agent:start", "agent:tool_call", "agent:critic_review", "agent:done", "agent:error", "graph:updated"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "data": {"type": "object"}
  }
}
